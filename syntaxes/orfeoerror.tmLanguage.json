{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "orfeoerror",
    "scopeName": "source.orfeoerror",
    "fileTypes": [ "orfeoerror" ],
    "patterns": [
        { "include": "#header" },
        { "include": "#line-number" },
        { "include": "#icon_eject" },
        { "include": "#icon_sequence-start" }
    ],
    "repository": {
        "header": {
            "name": "markup.heading.orfeoerror",
            "match": "^===OOPS!===(?=\\s|$)"
        },
        "line-number": {
            "name": "keyword.other.line-number.orfeoerror",
            "match": "^[1-9]\\d*➤"
        },
        "icon_eject": {
            "name": "constant.character.icon.eject.orfeoerror",
            "match": "(?<=^[1-9]\\d*➤.*)⏏"
        },
        "icon_sequence-start": {
            "name": "constant.character.icon.sequence-start.orfeoerror",
            "match": "(?<=^[1-9]\\d*➤.*)⭢"
        }
    }
}
